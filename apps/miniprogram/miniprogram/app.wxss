button::after {
  border: 0;
}

.screen {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 36rpx 72rpx;
  color: var(--theme-text);
  background:
    radial-gradient(circle at 88% -8%, var(--theme-surface-soft), transparent 34%),
    linear-gradient(155deg, var(--theme-bg-top) 0%, var(--theme-bg) 66%, var(--theme-bg-tail) 100%);
}

/* Team identity uses one shared layout; each team only supplies its crest and palette. */
.theme-team.screen {
  position: relative;
  isolation: isolate;
  background:
    linear-gradient(
      118deg,
      transparent 0%,
      transparent 56%,
      var(--theme-stripe-primary) 56%,
      var(--theme-stripe-primary) 72%,
      var(--theme-stripe-accent) 72%,
      var(--theme-stripe-accent) 77%,
      transparent 77%,
      transparent 100%
    ),
    linear-gradient(
      118deg,
      transparent 0%,
      transparent 79%,
      var(--theme-stripe-secondary) 79%,
      var(--theme-stripe-secondary) 89%,
      transparent 89%,
      transparent 100%
    ),
    linear-gradient(180deg, var(--theme-bg-top), var(--theme-bg) 58%, var(--theme-bg-tail));
}

.team-watermark {
  position: absolute;
  z-index: -1;
  top: 156rpx;
  right: -72rpx;
  width: 560rpx;
  height: 560rpx;
  opacity: 0.055;
  pointer-events: none;
}

.team-watermark-home {
  top: 330rpx;
  right: -94rpx;
  width: 690rpx;
  height: 690rpx;
}

.team-brand {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  min-width: 0;
  color: var(--theme-text);
  border-left: 6rpx solid var(--theme-team-accent);
}

.team-brand-crest {
  flex: 0 0 auto;
  object-fit: contain;
  filter: drop-shadow(0 10rpx 14rpx var(--theme-shadow));
}

.team-brand-copy,
.team-brand-name,
.team-brand-english {
  display: block;
  min-width: 0;
}

.team-brand-copy {
  padding-left: 18rpx;
}

.team-brand-name {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.15;
}

.team-brand-english {
  margin-top: 8rpx;
  color: var(--theme-accent);
  font-family: monospace;
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 0.14em;
  line-height: 1.2;
}

.team-brand-prominent {
  padding-left: 16rpx;
}

.team-brand-prominent .team-brand-crest {
  width: 156rpx;
  height: 156rpx;
}

.team-brand-compact {
  width: fit-content;
  margin-bottom: 30rpx;
  padding-left: 14rpx;
}

.team-brand-compact .team-brand-crest {
  width: 82rpx;
  height: 82rpx;
}

.team-brand-compact .team-brand-name {
  font-size: 25rpx;
}

.team-brand-compact .team-brand-english {
  margin-top: 5rpx;
  font-size: 14rpx;
}

.theme-team .home-atmosphere,
.theme-team .mount-mark {
  display: none;
}

.eyebrow {
  color: var(--theme-accent);
  font-family: monospace;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.24em;
}

.muted {
  color: var(--theme-muted-strong);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin: 0;
  color: var(--theme-on-accent);
  border-radius: 22rpx;
  background: linear-gradient(135deg, var(--theme-accent-high), var(--theme-accent-low));
  font-size: 29rpx;
  font-weight: 800;
  letter-spacing: 0.05em;
  box-shadow: 0 18rpx 42rpx var(--theme-shadow);
}

.primary-button[disabled] {
  color: var(--theme-disabled-text);
  background: var(--theme-disabled-bg);
  box-shadow: none;
}

.error-panel {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  color: var(--theme-danger);
  border-left: 6rpx solid var(--theme-danger);
  border-radius: 6rpx 18rpx 18rpx 6rpx;
  background: transparent;
  font-family: sans-serif;
  font-size: 25rpx;
  line-height: 1.65;
}

/* Page styles use a shared semantic layer so all four themes stay consistent. */
.screen .token-card,
.screen .token-field,
.screen .search-box,
.screen .player-card,
.screen .basket-panel,
.screen .profile-card,
.screen .detail-tabs,
.screen .metric-card,
.screen .overview-metric,
.screen .overview-group,
.screen .performance-tools,
.screen .performance-card,
.screen .game-tools,
.screen .game-card,
.screen .team-chip,
.screen .filter-chip,
.screen .direction-button,
.screen .sort-button,
.screen .reset-button,
.screen .scope-panel,
.screen .basket-person,
.screen .layer-tabs,
.screen .control-panel,
.screen .matrix-section,
.screen .shared-filters,
.screen .shared-game,
.screen .home-sheet,
.screen .replay-summary,
.screen .roster-group,
.screen .timeline-item,
.screen .replay-tab,
.screen .replay-seat,
.screen .day-part,
.screen .point-item,
.screen .replay-sheet {
  color: var(--theme-text) !important;
  border-color: var(--theme-line) !important;
  background: var(--theme-surface) !important;
  box-shadow: 0 22rpx 58rpx var(--theme-shadow) !important;
}

.screen .home-actions,
.screen .home-actions-trigger,
.screen .home-action-list button {
  color: var(--theme-text) !important;
  border-color: var(--theme-line) !important;
  background: transparent !important;
  box-shadow: none !important;
}

.screen .home-action-list .home-action-active {
  background: var(--theme-surface-soft) !important;
}

.screen .home-actions-trigger-active {
  background: var(--theme-surface-soft) !important;
}

.screen .entry-card {
  color: var(--theme-text) !important;
  border-color: var(--theme-line-strong) !important;
  background: linear-gradient(135deg, var(--theme-surface), var(--theme-surface-strong)) !important;
  box-shadow: 0 24rpx 58rpx var(--theme-shadow) !important;
}

.screen .entry-card-active,
.screen .player-card-active,
.screen .game-card-active {
  background: var(--theme-surface-soft) !important;
}

.screen .pending-entry .entry-symbol {
  color: var(--theme-muted) !important;
  background: var(--theme-surface-soft) !important;
}

.screen .privacy-note,
.screen .help-card,
.screen .hidden-note,
.screen .section-warning,
.screen .games-progress,
.screen .status-panel,
.screen .empty-panel,
.screen .shared-intro,
.screen .warning-panel,
.screen .person-error {
  color: var(--theme-muted) !important;
  border-color: var(--theme-line) !important;
  background: transparent !important;
  box-shadow: none !important;
}

.screen .section-warning,
.screen .warning-panel,
.screen .person-error {
  color: var(--theme-danger) !important;
}

.screen .home-note {
  color: var(--theme-muted) !important;
  border-color: var(--theme-line) !important;
  background: transparent !important;
  box-shadow: none !important;
}

.screen .home-note text:first-child {
  color: var(--theme-muted-strong) !important;
}

.screen .sheet-head,
.screen .matrix-heading,
.screen .matrix-player-head,
.screen .replay-head {
  border-color: var(--theme-line) !important;
  background: linear-gradient(120deg, var(--theme-surface-soft), var(--theme-surface-strong)) !important;
}

.screen .matrix-corner,
.screen .metric-label,
.screen .matrix-value,
.screen .shared-player,
.screen .basket-chip,
.screen .filter-picker,
.screen .performance-sort-picker,
.screen .edition-search,
.screen .token-input,
.screen .search-input {
  color: var(--theme-text-soft) !important;
  border-color: var(--theme-line) !important;
  background: var(--theme-surface-strong) !important;
}

.screen .hero-kicker,
.screen .hero-title text,
.screen .entry-action,
.screen .action-symbol,
.screen .help-title,
.screen .player-open,
.screen .swipe-hint,
.screen .compare-help text:first-child,
.screen .theme-copy text:first-child,
.screen .sheet-head > view text:first-child,
.screen .more-button,
.screen .team-toggle,
.screen .refresh-player {
  color: var(--theme-accent) !important;
}

.screen .status-dot,
.screen .visibility-button,
.screen .compare-add,
.screen .basket-head button,
.screen .replay-close,
.screen .section-number,
.screen .release-item text:first-child {
  color: var(--theme-accent) !important;
}

.screen .entry-symbol,
.screen .basket-go,
.screen .filter-chip.active,
.screen .sort-button.active,
.screen .detail-tab.active,
.screen .replay-tab.active,
.screen .tab-row button.active,
.screen .chip-row button.active {
  color: var(--theme-on-accent) !important;
  border-color: var(--theme-accent) !important;
  background: var(--theme-accent) !important;
}

.screen .page-title,
.screen .entry-title,
.screen .player-name,
.screen .compare-title,
.screen .section-title,
.screen .replay-title,
.screen .sheet-head > view text:last-child,
.screen .home-actions-trigger > view:first-child text:first-child,
.screen .matrix-person-copy text:first-child {
  color: var(--theme-text) !important;
}

.screen .hero-copy,
.screen .lead,
.screen .card-number,
.screen .field-label,
.screen .entry-description,
.screen .entry-number,
.screen .entry-status,
.screen .home-footer,
.screen .home-actions-trigger > view:first-child text:last-child,
.screen .home-actions-state,
.screen .home-action-list button > view text:last-child,
.screen .action-arrow,
.screen .privacy-note,
.screen .result-state,
.screen .player-sect,
.screen .detail-note,
.screen .compare-subtitle,
.screen .scope-label,
.screen .basket-heading text:last-child,
.screen .matrix-heading > view text:last-child,
.screen .shared-filter-count,
.screen .compare-help,
.screen .sheet-section > view,
.screen .release-item {
  color: var(--theme-muted) !important;
}

.screen .portrait-frame,
.screen .detail-tabs-track,
.screen .performance-metrics,
.screen .picker-row,
.screen .filter-group,
.screen .shared-player-list,
.screen .replay-timeline,
.screen .replay-tabs,
.screen .replay-detail-row,
.screen .replay-points {
