}

.screen .matrix-value.best,
.screen .metric-label.active {
  border-color: var(--theme-gold) !important;
  background: var(--theme-surface-soft) !important;
}

.screen .danger,
.screen .remove,
.screen .replay-error {
  color: var(--theme-danger) !important;
}

.screen .home-overlay,
.screen .replay-overlay {
  background: var(--theme-overlay) !important;
}

.theme-light image,
.theme-yulehui image,
.theme-jinfeng-xiyulou image {
  color-scheme: light;
}
