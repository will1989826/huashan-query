}

.screen .scope-value,
.screen .picker-value,
.screen .player-score,
.screen .basket-name text:first-child,
.screen .performance-name,
.screen .game-title-row,
.screen .shared-game-head,
.screen .replay-block-title,
.screen .section-title.question {
