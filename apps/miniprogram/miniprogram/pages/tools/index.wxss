.tools-screen{padding-top:54rpx}.page-title{margin-top:18rpx;font-size:58rpx;font-weight:800;letter-spacing:-.05em}.lead{display:block;margin-top:18rpx;color:var(--theme-muted);font:24rpx/1.7 sans-serif}.tool-list{display:flex;flex-direction:column;gap:20rpx;margin-top:48rpx}.tool-card{display:grid;grid-template-columns:46rpx 90rpx 1fr;gap:18rpx;padding:28rpx;border:2rpx solid var(--theme-line-strong);border-radius:30rpx 30rpx 30rpx 10rpx;background:linear-gradient(135deg,var(--theme-surface),var(--theme-surface-strong));box-shadow:0 24rpx 58rpx var(--theme-shadow)}.tool-card-active{background:var(--theme-surface-soft)}.tool-number{color:var(--theme-muted);font:18rpx monospace}.tool-mark{display:flex;width:82rpx;height:82rpx;align-items:center;justify-content:center;color:var(--theme-on-accent);border-radius:28rpx 28rpx 28rpx 8rpx;background:var(--theme-accent);font-size:28rpx;font-weight:800}.tool-title,.tool-copy{display:block}.tool-title{font-size:30rpx;font-weight:800}.tool-copy{margin-top:9rpx;color:var(--theme-muted);font:20rpx/1.55 sans-serif}.tool-action{grid-column:2/4;color:var(--theme-accent);font:20rpx sans-serif;font-weight:800}.tool-note{margin-top:34rpx;padding:24rpx 8rpx;border-top:2rpx solid var(--theme-line);color:var(--theme-muted);font:20rpx/1.6 sans-serif}
