.draw-screen{padding:54rpx 24rpx 80rpx}.page-title{margin-top:18rpx;font-size:54rpx;font-weight:800;letter-spacing:-.05em}.lead{display:block;margin-top:16rpx;color:var(--theme-muted);font:22rpx/1.65 sans-serif}.filter-panel{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:34rpx;padding:22rpx;border:2rpx solid var(--theme-line);border-radius:25rpx;background:var(--theme-surface)}.filter-panel picker:nth-child(3),.filter-panel button{grid-column:1/-1}.picker-field,.control-field{padding:17rpx;border:2rpx solid var(--theme-line);border-radius:16rpx;background:var(--theme-surface-strong)}.picker-field text,.picker-field b,.control-field text,.control-field b{display:block}.picker-field text,.control-field text{color:var(--theme-muted);font:17rpx sans-serif}.picker-field b,.control-field b{margin-top:7rpx;font-size:22rpx}.filter-panel button{height:82rpx;font-size:24rpx}.empty-panel{display:flex;flex-direction:column;gap:10rpx;margin-top:26rpx;padding:50rpx 16rpx;color:var(--theme-muted);border-top:2rpx solid var(--theme-line);font:20rpx/1.6 sans-serif;text-align:center}.empty-panel text:first-child{color:var(--theme-text);font-size:26rpx;font-weight:800}.draw-result{margin-top:26rpx}.summary{display:flex;flex-direction:column;gap:8rpx;padding:24rpx;border:2rpx solid var(--theme-line);border-radius:20rpx;background:var(--theme-surface)}.summary b{font-size:27rpx}.summary text{color:var(--theme-muted);font:19rpx/1.5 sans-serif}.warning-panel{margin-top:12rpx;padding:18rpx;color:var(--theme-danger);border-left:6rpx solid var(--theme-danger);font:19rpx/1.5 sans-serif}.simulation-controls{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:20rpx}.projection-note{display:block;margin:18rpx 4rpx;color:var(--theme-muted);font:18rpx/1.5 sans-serif}.score-list{display:flex;flex-direction:column;gap:10rpx}.score-card{display:grid;grid-template-columns:48rpx 1fr 90rpx 100rpx;align-items:center;gap:10rpx;padding:18rpx 14rpx;border:2rpx solid var(--theme-line);border-radius:18rpx;background:var(--theme-surface)}.score-card.top{border-left:7rpx solid var(--theme-gold)}.rank-no{color:var(--theme-accent);font:bold 25rpx monospace}.team-name{min-width:0}.team-name b,.team-name text,.total b,.total text,.game-score b,.game-score text{display:block}.team-name b{overflow:hidden;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.team-name text,.total text,.game-score text{margin-top:5rpx;color:var(--theme-muted);font:14rpx sans-serif}.total,.game-score{text-align:right}.total b{color:var(--theme-gold);font:700 24rpx monospace}.game-score b{font:700 21rpx monospace}.game-score input{box-sizing:border-box;width:92rpx;height:54rpx;padding:6rpx;color:var(--theme-text);border:2rpx solid var(--theme-gold);border-radius:12rpx;background:var(--theme-surface-strong);font:20rpx monospace;text-align:center}
