.session-screen {
  position: relative;
  overflow: hidden;
  padding-top: 92rpx;
}

.mount-mark {
  position: absolute;
  top: 12rpx;
  right: -170rpx;
  width: 560rpx;
  height: 400rpx;
  opacity: 0.62;
}

.ridge {
  position: absolute;
  width: 370rpx;
  height: 370rpx;
  border: 2rpx solid var(--theme-line);
  transform: rotate(45deg) skew(-10deg, -10deg);
}

.ridge-one {
  top: 30rpx;
  left: 70rpx;
}

.ridge-two {
  top: 130rpx;
  left: -20rpx;
  border-color: var(--theme-line);
}

.intro,
.token-card,
.privacy-note {
  position: relative;
  z-index: 1;
}

.session-screen > .team-brand {
  margin-bottom: 52rpx;
}

.title {
  margin-top: 22rpx;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.08;
  letter-spacing: -0.07em;
}

.title text {
  display: block;
  color: var(--theme-accent);
}

.lead {
  max-width: 570rpx;
  margin-top: 28rpx;
  color: var(--theme-muted-strong);
  font-family: sans-serif;
  font-size: 27rpx;
  line-height: 1.8;
}

.token-card {
  margin-top: 72rpx;
  padding: 34rpx;
  border: 2rpx solid var(--theme-line);
  border-radius: 32rpx;
  background: linear-gradient(145deg, var(--theme-surface), var(--theme-surface-strong));
  box-shadow: 0 36rpx 90rpx var(--theme-shadow);
}

.card-number {
  color: var(--theme-muted);
  font-family: monospace;
  font-size: 20rpx;
  letter-spacing: 0.15em;
}

.card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid var(--theme-line);
  font-size: 38rpx;
  font-weight: 700;
}

.status-dot {
  color: var(--theme-accent);
  font-family: sans-serif;
  font-size: 20rpx;
  font-weight: 500;
}

.field-label {
  margin-top: 34rpx;
  color: var(--theme-muted-strong);
  font-family: sans-serif;
  font-size: 22rpx;
  font-weight: 700;
}

.token-field {
  display: flex;
  align-items: center;
  height: 98rpx;
  margin-top: 14rpx;
  padding-left: 26rpx;
  border: 2rpx solid var(--theme-line-strong);
  border-radius: 22rpx;
  background: var(--theme-bg);
}

.token-input {
  flex: 1;
  min-width: 0;
  color: var(--theme-text);
  font-family: monospace;
  font-size: 25rpx;
}

.token-placeholder {
  color: var(--theme-muted);
}

.visibility-button {
  width: 112rpx;
  height: 64rpx;
  margin: 0 14rpx;
  padding: 0;
  color: var(--theme-accent);
  background: transparent;
  font-family: sans-serif;
  font-size: 23rpx;
  line-height: 64rpx;
}

.validate-button {
  margin-top: 26rpx;
}

.token-guide {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  padding: 30rpx 32rpx;
  border: 2rpx solid var(--theme-line);
  border-radius: 28rpx;
  background: linear-gradient(145deg, var(--theme-surface), var(--theme-surface-strong));
  box-shadow: 0 28rpx 72rpx var(--theme-shadow);
}

.guide-heading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: var(--theme-text);
  font-size: 32rpx;
  font-weight: 700;
}

.guide-number {
  color: var(--theme-accent);
  font-family: monospace;
  font-size: 20rpx;
  letter-spacing: 0.12em;
}

.guide-lead,
.guide-tip,
.guide-steps text {
  display: block;
  font-family: sans-serif;
  line-height: 1.75;
}

.guide-lead {
  margin-top: 20rpx;
  color: var(--theme-muted-strong);
  font-size: 24rpx;
}

.guide-steps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.guide-steps text {
  color: var(--theme-text-soft);
  font-size: 23rpx;
}

.guide-steps .guide-method {
  margin-top: 8rpx;
  color: var(--theme-text);
  font-weight: 700;
}

.guide-steps b {
  color: var(--theme-accent);
}

.guide-tip {
  margin-top: 22rpx;
  padding-top: 18rpx;
  color: var(--theme-muted);
  border-top: 2rpx solid var(--theme-line);
  font-size: 21rpx;
}

.privacy-note {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 34rpx;
  padding: 24rpx 10rpx 0;
  color: var(--theme-muted);
  border-top: 2rpx solid var(--theme-line);
  background: transparent;
  font-family: sans-serif;
  font-size: 22rpx;
  line-height: 1.65;
}

.privacy-index {
  color: var(--theme-text-soft);
  font-weight: 700;
}
