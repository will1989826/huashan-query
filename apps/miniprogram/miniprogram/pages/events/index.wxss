.data-screen{padding-top:54rpx}.page-title{margin-top:18rpx;font-size:58rpx;font-weight:800;letter-spacing:-.05em}.lead{display:block;margin-top:18rpx;color:var(--theme-muted);font:24rpx/1.7 sans-serif}.filter-panel,.result-panel,.member-card{border:2rpx solid var(--theme-line);background:var(--theme-surface);box-shadow:0 20rpx 50rpx var(--theme-shadow)}.filter-panel{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:38rpx;padding:24rpx;border-radius:28rpx}.filter-panel picker:nth-child(3),.query-button{grid-column:1/-1}.picker-field{padding:18rpx;border:2rpx solid var(--theme-line);border-radius:18rpx;background:var(--theme-surface-strong)}.picker-field text,.picker-field b{display:block}.picker-field text{color:var(--theme-muted);font:18rpx sans-serif}.picker-field b{margin-top:8rpx;font-size:24rpx}.query-button{height:82rpx;border-radius:18rpx;font-size:25rpx}.empty-panel{display:flex;flex-direction:column;gap:12rpx;margin-top:28rpx;padding:46rpx 12rpx;border-top:2rpx solid var(--theme-line);color:var(--theme-muted);font:22rpx/1.6 sans-serif;text-align:center}.empty-panel text:first-child{color:var(--theme-text);font-size:27rpx;font-weight:700}.result-panel{margin-top:28rpx;border-radius:28rpx;overflow:hidden}.result-head{padding:24rpx;border-bottom:2rpx solid var(--theme-line)}.result-head text,.result-head b{display:block}.result-head text{color:var(--theme-muted);font:17rpx sans-serif;letter-spacing:.1em}.result-head b{margin-top:8rpx;font-size:25rpx}.event-tabs{white-space:nowrap;border-bottom:2rpx solid var(--theme-line)}.tabs-track{display:flex;padding:12rpx}.tabs-track button{flex:0 0 auto;margin:0 8rpx 0 0;padding:15rpx 24rpx;color:var(--theme-muted);border:0;border-radius:14rpx;background:transparent;font-size:22rpx}.tabs-track button.active{color:var(--theme-on-accent);background:var(--theme-accent)}.status-line,.warning-panel{padding:18rpx 24rpx;color:var(--theme-muted);border-bottom:2rpx solid var(--theme-line);font:20rpx/1.5 sans-serif}.warning-panel{color:var(--theme-danger)}.sort-row{display:flex;justify-content:space-between;align-items:center;padding:18rpx 24rpx;border-bottom:2rpx solid var(--theme-line);font:20rpx sans-serif}.sort-row button{margin:0;padding:8rpx 18rpx;color:var(--theme-accent);border:2rpx solid var(--theme-line);border-radius:14rpx;background:transparent;font-size:19rpx}.rank-row{display:grid;grid-template-columns:50rpx minmax(130rpx,1fr) repeat(3,76rpx);align-items:center;gap:10rpx;min-height:100rpx;padding:12rpx 20rpx;border-bottom:2rpx solid var(--theme-line)}.rank-row:last-child{border-bottom:0}.rank-no{color:var(--theme-accent);font:bold 28rpx monospace}.rank-main{min-width:0}.rank-main b,.rank-main text,.rank-score b,.rank-score text{display:block}.rank-main b{overflow:hidden;font-size:23rpx;text-overflow:ellipsis;white-space:nowrap}.rank-main text,.rank-score text{margin-top:5rpx;color:var(--theme-muted);font:16rpx sans-serif}.rank-score{text-align:right}.rank-score b{font:700 23rpx monospace}.rank-badges{grid-column:3/6;display:flex;justify-content:flex-end;gap:10rpx;color:var(--theme-muted);font:17rpx sans-serif}.back-button{margin:0 0 34rpx;padding:0;color:var(--theme-accent);border:0;background:transparent;font-size:22rpx;text-align:left}.team-chief{display:block;margin-top:16rpx;color:var(--theme-muted);font:19rpx sans-serif}.member-list{display:flex;flex-direction:column;gap:16rpx;margin-top:30rpx}.member-card{display:grid;grid-template-columns:1.5fr repeat(4,1fr);gap:10rpx;padding:24rpx 18rpx;border-radius:22rpx}.member-card view{text-align:right}.member-card view:first-child{text-align:left}.member-card b,.member-card text{display:block}.member-card b{overflow:hidden;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.member-card text{margin-top:6rpx;color:var(--theme-muted);font:15rpx sans-serif}.member-awards{grid-column:1/-1;padding-top:12rpx;color:var(--theme-muted);border-top:2rpx solid var(--theme-line);font:16rpx sans-serif;text-align:right}
