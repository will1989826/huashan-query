@import "../player/index.wxss";

.compare-screen {
  padding-top: 44rpx;
}

.compare-hero,
.shared-game-head,
.hidden-note,
.shared-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.compare-title {
  margin-top: 13rpx;
  font-size: 50rpx;
  font-weight: 800;
  letter-spacing: -0.05em;
}

.compare-subtitle {
  display: block;
  margin-top: 7rpx;
  color: var(--theme-muted);
  font-family: monospace;
  font-size: 20rpx;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 9rpx;
}

.hero-actions button,
.hidden-note button {
  width: auto;
  height: 58rpx;
  margin: 0;
  padding: 0 16rpx;
  color: var(--theme-accent);
  border: 2rpx solid var(--theme-line-strong);
  border-radius: 14rpx;
  background: var(--theme-surface);
  font-family: sans-serif;
  font-size: 19rpx;
  line-height: 54rpx;
}

.hero-actions .danger {
  color: var(--theme-danger);
  border-color: var(--theme-danger);
}

.hero-actions .roster-replace { border-style: dashed; color: var(--theme-muted); }
.hero-actions button[disabled] { opacity: .5; }

.scope-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 34rpx;
  padding: 15rpx;
  border: 2rpx solid var(--theme-line);
  border-radius: 23rpx;
  background: var(--theme-surface);
}

.scope-panel picker,
.control-picker,
.shared-filters picker {
  min-width: 0;
  padding: 14rpx 17rpx;
  border-radius: 15rpx;
  background: var(--theme-surface);
}

.season-scope {
  min-width: 0;
}

.season-scope picker {
  padding-bottom: 10rpx;
}

.season-scope input {
  box-sizing: border-box;
  height: 50rpx;
  padding: 0 10rpx;
  color: var(--theme-text-soft);
  border-top: 2rpx solid var(--theme-line);
  font-family: sans-serif;
  font-size: 17rpx;
}

.scope-label,
.scope-value,
.control-picker text,
.shared-filters picker text {
  display: block;
  overflow: hidden;
  font-family: sans-serif;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scope-label,
.control-picker text:first-child,
.shared-filters picker text:first-child {
  color: var(--theme-muted);
  font-size: 17rpx;
  font-weight: 700;
}

.scope-value,
.control-picker text:last-child,
.shared-filters picker text:last-child {
  margin-top: 6rpx;
  color: var(--theme-text-soft);
  font-size: 21rpx;
}

.basket-heading,
.matrix-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 18rpx;
  font-family: sans-serif;
}

.basket-heading text:first-child,
.matrix-heading > view text:first-child {
  color: var(--theme-text-soft);
  font-size: 20rpx;
  font-weight: 800;
}

.basket-heading text:last-child,
.matrix-heading > view text:last-child {
  color: var(--theme-muted);
  font-size: 16rpx;
}

.matrix-heading > view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.basket-scroll {
  width: 100%;
  margin-top: 10rpx;
  padding-bottom: 6rpx;
  white-space: nowrap;
}

.basket-list {
  display: flex;
  gap: 10rpx;
}

.basket-person {
  display: flex;
  box-sizing: border-box;
  width: 186rpx;
  flex: 0 0 186rpx;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 12rpx;
  border: 2rpx solid var(--theme-line);
  border-radius: 17rpx;
  background: var(--theme-surface);
}

.basket-person.hidden {
  opacity: 0.55;
}

.basket-person image,
.basket-person .avatar-fallback {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 auto;
  border-radius: 15rpx 15rpx 15rpx 5rpx;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--theme-muted);
  background: var(--theme-surface-strong);
  font-size: 20rpx;
}

.basket-name {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.basket-name text:first-child {
  overflow: hidden;
  font-size: 19rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.basket-name text:last-child {
  color: var(--theme-muted);
  font-family: monospace;
  font-size: 16rpx;
}

.basket-actions {
  display: flex;
  width: 100%;
  justify-content: space-between;
  padding-top: 5rpx;
  border-top: 2rpx solid var(--theme-line);
}

.basket-person button {
  width: auto;
  height: 42rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0 8rpx;
  color: var(--theme-accent);
  background: transparent;
  font-family: sans-serif;
  font-size: 17rpx;
  line-height: 42rpx;
}

.basket-person button.remove {
  color: var(--theme-danger);
  font-size: 23rpx;
}

.hidden-note {
  margin-top: 12rpx;
  padding: 12rpx 0 12rpx 16rpx;
  color: var(--theme-muted);
  border-left: 4rpx solid var(--theme-gold);
  background: transparent;
  font-family: sans-serif;
  font-size: 18rpx;
  line-height: 1.5;
}

.hidden-note button {
  height: 44rpx;
  flex: 0 0 auto;
  color: var(--theme-gold);
  border: 0;
  background: transparent;
  line-height: 44rpx;
}

.tab-row,
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.layer-tabs {
  margin-top: 28rpx;
  padding: 7rpx;
  border: 2rpx solid var(--theme-line);
  border-radius: 20rpx;
  background: var(--theme-bg);
}

.tab-row button,
.chip-row button {
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  height: 58rpx;
  flex: 1 1 140rpx;
  margin: 0;
  padding: 0 12rpx;
  color: var(--theme-muted);
  border: 2rpx solid transparent;
  border-radius: 13rpx;
  background: var(--theme-surface-soft);
  font-family: sans-serif;
  font-size: 19rpx;
  line-height: 54rpx;
}

.tab-row button.active,
.chip-row button.active {
  color: var(--theme-on-accent);
  border-color: var(--theme-accent-high);
  background: var(--theme-accent);
  font-weight: 800;
}

.layer-tabs button {
  flex-basis: 30%;
  background: transparent;
}

.control-panel {
  margin-top: 14rpx;
  padding: 18rpx;
  border: 2rpx solid var(--theme-line);
  border-radius: 22rpx;
  background: var(--theme-surface);
}

.sub-tabs button {
  flex-basis: 120rpx;
}

.deep-controls {
  display: flex;
  align-items: stretch;
  flex-wrap: wrap;
  gap: 12rpx;
}

.deep-controls .sub-tabs {
  min-width: 310rpx;
  flex: 2 1 360rpx;
}

.control-picker {
  flex: 1 1 220rpx;
}

.custom-picker {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--theme-line);
}

.custom-group + .custom-group {
  margin-top: 16rpx;
}

.custom-group > text {
  display: block;
  margin-bottom: 9rpx;
  color: var(--theme-muted);
  font-family: sans-serif;
  font-size: 18rpx;
  font-weight: 700;
}

.custom-group .chip-row button {
  flex: 1 1 175rpx;
}

.shared-intro {
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-top: 2rpx solid var(--theme-line);
  border-bottom: 2rpx solid var(--theme-line);
  border-radius: 0;
  background: transparent;
  font-family: sans-serif;
}

.shared-intro text:first-child {
  color: var(--theme-text-soft);
  font-size: 21rpx;
  font-weight: 800;
}

.shared-intro text:last-child {
  color: var(--theme-muted);
  font-size: 18rpx;
}

.status-panel,
.warning-panel,
.person-error {
  display: flex;
  min-height: 74rpx;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  margin-top: 15rpx;
  padding: 15rpx 20rpx;
  color: var(--theme-muted-strong);
  border: 2rpx dashed var(--theme-line-strong);
  border-radius: 18rpx;
  font-family: sans-serif;
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}

.compare-radar-card {
  --compare-series-0: var(--theme-radar-1);
  --compare-series-1: var(--theme-radar-2);
  --compare-series-2: var(--theme-radar-3);
  --compare-series-3: var(--theme-radar-4);
  margin-top: 16rpx;
  padding: 26rpx;
  overflow: hidden;
  border: 2rpx solid var(--theme-line);
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 10% 4%, var(--theme-accent-wash), transparent 34%),
    var(--theme-surface);
}

.compare-radar-card .profile-radar-head button[disabled] {
  color: var(--theme-disabled-text);
  background: var(--theme-disabled-bg);
  opacity: 0.72;
}

.compare-radar-canvas {
  display: block;
  width: 100%;
  height: 590rpx;
  margin-top: 8rpx;
}

.compare-radar-legend {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx 18rpx;
  margin-top: 4rpx;
}

.compare-radar-person {
  display: grid;
  grid-template-columns: 18rpx minmax(0, 1fr);
  gap: 11rpx;
  min-width: 0;
  padding: 13rpx 4rpx;
  border-bottom: 2rpx solid var(--theme-line);
}

.compare-radar-person > text {
  width: 16rpx;
  height: 16rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  background: var(--series-color);
}

.compare-radar-person > view,
.compare-radar-person > view text {
  display: block;
  min-width: 0;
}

.compare-radar-person > view text:first-child {
  color: var(--theme-text);
  font-size: 21rpx;
  font-weight: 800;
}

.compare-radar-person > view text:last-child {
  margin-top: 5rpx;
  color: var(--theme-muted);
  font: 16rpx/1.55 sans-serif;
}

.compare-radar-person.series-0 { --series-color: var(--compare-series-0); }
.compare-radar-person.series-1 { --series-color: var(--compare-series-1); }
.compare-radar-person.series-2 { --series-color: var(--compare-series-2); }
.compare-radar-person.series-3 { --series-color: var(--compare-series-3); }
.compare-radar-person.series-0 > text { box-shadow: 0 0 0 5rpx var(--theme-radar-1-wash); }
.compare-radar-person.series-1 > text { box-shadow: 0 0 0 5rpx var(--theme-radar-2-wash); }
.compare-radar-person.series-2 > text { box-shadow: 0 0 0 5rpx var(--theme-radar-3-wash); }
.compare-radar-person.series-3 > text { box-shadow: 0 0 0 5rpx var(--theme-radar-4-wash); }

.radar-picker-overlay {
  position: fixed;
  z-index: 140;
  inset: 0;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  background: var(--theme-bg);
  box-sizing: border-box;
}

.radar-picker {
  box-sizing: border-box;
  width: 100%;
  max-height: 84vh;
  padding: 26rpx;
  border: 2rpx solid var(--theme-line-strong);
  border-radius: 30rpx;
  background: var(--theme-surface);
  box-shadow: 0 24rpx 70rpx var(--theme-shadow);
}

.radar-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--theme-line);
}

.radar-picker-head view,
.radar-picker-head text {
  display: block;
}

.radar-picker-head view text:first-child {
  color: var(--theme-accent);
  font: 800 15rpx monospace;
  letter-spacing: 0.14em;
}

.radar-picker-head view text:last-child {
  margin-top: 6rpx;
  color: var(--theme-text);
  font-size: 27rpx;
  font-weight: 800;
}

.radar-picker-head button,
.radar-reset {
  width: auto;
  height: 54rpx;
  margin: 0;
  padding: 0 17rpx;
  color: var(--theme-accent);
  border: 2rpx solid var(--theme-line-strong);
  border-radius: 14rpx;
  background: var(--theme-surface-strong);
  font-family: sans-serif;
  font-size: 18rpx;
  line-height: 50rpx;
}

.radar-picker-note {
  display: block;
  margin: 20rpx 0 14rpx;
  color: var(--theme-muted);
  font: 19rpx/1.55 sans-serif;
}

.radar-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.radar-option {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 32rpx;
  min-width: 0;
  min-height: 96rpx;
  align-items: center;
  margin: 0;
  padding: 13rpx 15rpx;
  color: var(--theme-text);
  border: 2rpx solid var(--theme-line);
  border-radius: 17rpx;
  background: var(--theme-surface-strong);
  text-align: left;
}

.radar-option.selected {
  border-color: var(--theme-accent);
  background: var(--theme-accent-wash);
  box-shadow: inset 0 0 0 2rpx var(--theme-accent);
}

.radar-option.unavailable {
  opacity: 0.56;
}

.radar-option text {
  display: block;
  min-width: 0;
}

.radar-option text:first-child {
  overflow: hidden;
  font-size: 21rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.radar-option text:nth-child(2) {
  grid-column: 1;
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--theme-muted);
  font: 16rpx sans-serif;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.radar-option text:last-child {
  grid-column: 2;
  grid-row: 1 / span 2;
  color: var(--theme-accent);
  font-size: 25rpx;
  text-align: right;
}

.radar-reset {
  display: block;
  margin: 18rpx 0 6rpx auto;
  background: transparent;
}

.status-panel button {
  width: auto;
  height: 48rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0 15rpx;
  color: var(--theme-accent);
  border: 2rpx solid var(--theme-line-strong);
  border-radius: 12rpx;
  background: var(--theme-surface);
  font-family: sans-serif;
  font-size: 18rpx;
  line-height: 44rpx;
}

.warning-panel,
.person-error {
  color: var(--theme-danger);
  border-style: solid;
  border-color: var(--theme-danger);
  background: transparent;
}

.matrix-section {
  overflow: hidden;
  margin-top: 16rpx;
  border: 2rpx solid var(--theme-line);
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  background: var(--theme-surface);
}

.matrix-heading {
  margin: 0;
  padding: 18rpx 20rpx;
  border-bottom: 2rpx solid var(--theme-line);
  background: linear-gradient(120deg, var(--theme-surface-soft), var(--theme-surface-strong));
}

.swipe-hint {
  color: var(--theme-accent);
  font-size: 17rpx;
  white-space: nowrap;
}

.matrix-corner,
.metric-label {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 10rpx;
  border-bottom: 2rpx solid var(--theme-line);
  font-family: sans-serif;
  text-align: center;
}

.matrix-corner {
  min-height: 190rpx;
  color: var(--theme-muted-strong);
  border-right: 2rpx solid var(--theme-line-strong);
  background: var(--theme-surface);
  font-size: 20rpx;
  font-weight: 800;
}

.matrix-corner text:last-child {
  margin-top: 5rpx;
  color: var(--theme-muted);
  font-size: 15rpx;
  font-weight: 400;
}

.metric-label {
  height: 84rpx;
  color: var(--theme-muted-strong);
  border-right: 2rpx solid var(--theme-line-strong);
  background: var(--theme-surface-strong);
  font-size: 17rpx;
  line-height: 1.2;
}

.identity-metric-label {
  display: flex;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  overflow: hidden;
}

.identity-primary-label {
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  padding: 2rpx 8rpx;
  color: var(--theme-accent);
  border: 2rpx solid var(--theme-accent-high);
  border-radius: 999rpx;
  background: var(--theme-accent-wash);
  flex: 0 1 auto;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-context-label {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  color: var(--theme-muted-strong);
  flex: 0 1 auto;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-label .metric-sort-mark {
  margin-top: 4rpx;
  color: var(--theme-muted);
  font-family: monospace;
  font-size: 15rpx;
}

.metric-label.active {
  color: var(--theme-gold);
  background: var(--theme-gold-wash);
}

.metric-label.active .metric-sort-mark {
  color: var(--theme-gold);
}

.matrix-scroll {
  width: 100%;
  white-space: nowrap;
}

.matrix-grid {
  display: grid;
  min-width: 100%;
  align-items: stretch;
}

.matrix-sticky {
  position: sticky;
  left: 0;
  z-index: 2;
  box-shadow: 10rpx 0 24rpx var(--theme-shadow);
}

.matrix-corner.matrix-sticky {
  z-index: 3;
}

.matrix-player-head {
  box-sizing: border-box;
  display: flex;
  position: relative;
  min-height: 190rpx;
  min-width: 0;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 12rpx 8rpx;
  border-right: 2rpx solid var(--theme-line);
  border-bottom: 2rpx solid var(--theme-line);
  background: linear-gradient(160deg, var(--theme-surface-soft), var(--theme-surface-strong));
}

.matrix-player-head image.matrix-crest {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 0;
  opacity: 0.9;
}

.matrix-player-head image,
.matrix-player-head .avatar-fallback {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 auto;
  border-radius: 17rpx 17rpx 17rpx 5rpx;
}

.matrix-person-copy {
  display: flex;
  max-width: 100%;
  align-items: center;
  flex-direction: column;
  margin-top: 6rpx;
}

.matrix-person-copy text:first-child {
  max-width: 100%;
  overflow: hidden;
  color: var(--theme-text);
  font-size: 19rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.matrix-person-copy text:nth-child(2) {
  color: var(--theme-muted);
  font-family: monospace;
  font-size: 14rpx;
}

.matrix-person-copy text:nth-child(3) {
  max-width: 100%;
  color: var(--theme-gold);
  font-family: sans-serif;
  font-size: 13rpx;
  line-height: 1.3;
  text-align: center;
  white-space: normal;
}

.matrix-power {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: var(--theme-gold);
  font-family: monospace;
  font-size: 17rpx;
  font-weight: 800;
}

.matrix-power text:last-child {
  color: var(--theme-muted);
  font-family: sans-serif;
  font-size: 12rpx;
  font-weight: 400;
}

.matrix-value {
  box-sizing: border-box;
  display: flex;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--theme-text-soft);
  border-right: 2rpx solid var(--theme-line);
  border-bottom: 2rpx solid var(--theme-line);
  background: var(--theme-surface-strong);
  font-family: monospace;
  font-size: 22rpx;
  font-weight: 800;
}

.matrix-value.best {
  color: var(--theme-gold);
  background: linear-gradient(135deg, var(--theme-gold-wash), var(--theme-gold-wash));
  box-shadow: inset 0 0 0 2rpx var(--theme-gold);
}

.matrix-value text:last-child:not(:first-child) {
  margin-top: 3rpx;
  color: var(--theme-danger);
  font-family: sans-serif;
  font-size: 12rpx;
  font-weight: 400;
}

.shared-filters {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 15rpx;
  padding: 14rpx;
  border: 2rpx solid var(--theme-line);
  border-radius: 20rpx;
  background: var(--theme-surface);
}

.shared-game-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 14rpx;
}

.shared-filter-count {
  display: block;
  margin-top: 10rpx;
  color: var(--theme-muted);
  font-family: sans-serif;
  font-size: 17rpx;
  text-align: right;
}

.shared-game {
  padding: 21rpx;
  border: 2rpx solid var(--theme-line);
  border-radius: 23rpx;
  background: var(--theme-surface);
}

.shared-game-head > view {
  display: flex;
  flex-direction: column;
  color: var(--theme-text-soft);
  font-family: monospace;
  font-size: 20rpx;
}

.shared-game-head > view text:last-child,
.shared-game-head > text:nth-child(2) {
  color: var(--theme-muted);
  font-family: sans-serif;
  font-size: 17rpx;
}

.shared-game-head > text:nth-child(2) {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shared-game-head > text:last-child {
  color: var(--theme-accent);
  font-family: sans-serif;
  font-size: 18rpx;
  font-weight: 700;
}

.shared-player-list {
  display: flex;
  gap: 8rpx;
  margin-top: 17rpx;
}

.shared-player-scroll {
  width: 100%;
  white-space: nowrap;
}

.shared-player {
  display: flex;
  box-sizing: border-box;
  width: 218rpx;
  flex: 0 0 218rpx;
  flex-wrap: wrap;
  gap: 5rpx 10rpx;
  padding: 13rpx;
  border-radius: 13rpx;
  background: var(--theme-surface);
  font-family: sans-serif;
  font-size: 17rpx;
}

.shared-player text:first-child {
  width: 100%;
  overflow: hidden;
  color: var(--theme-text-soft);
  font-size: 19rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shared-player text:nth-child(2) {
  color: var(--theme-muted-strong);
}

.shared-player text:nth-child(3) {
  color: var(--theme-gold);
  font-weight: 700;
}

.shared-player .won,
.shared-player .marks {
  color: var(--theme-accent);
}

.shared-player .lost {
  color: var(--theme-danger);
}

.shared-player .marks {
  width: 100%;
}

.compare-help {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 30rpx;
  padding: 20rpx 4rpx 0;
  color: var(--theme-muted);
  border-top: 2rpx solid var(--theme-line);
  font-family: sans-serif;
  font-size: 18rpx;
  line-height: 1.65;
}

.empty-panel {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 38rpx;
  color: var(--theme-muted);
  border: 2rpx dashed var(--theme-line);
  border-radius: 28rpx;
  font-family: sans-serif;
}

.empty-panel button {
  width: 260rpx;
  color: var(--theme-on-accent);
  background: var(--theme-accent);
  font-family: sans-serif;
  font-size: 21rpx;
  font-weight: 800;
}

@media (max-width: 520px) {
  .compare-hero {
    align-items: flex-start;
  }

  .compare-title {
    font-size: 42rpx;
  }

  .hero-actions {
    max-width: 220rpx;
  }

  .hero-actions button {
    flex: 1 1 100%;
  }

  .matrix-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 9rpx;
  }

  .compare-radar-legend {
    grid-template-columns: 1fr;
  }

  .radar-options {
    grid-template-columns: 1fr;
  }

}
