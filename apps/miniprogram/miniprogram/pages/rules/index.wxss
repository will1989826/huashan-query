.rules-screen{padding:54rpx 24rpx 80rpx}.page-title{margin-top:18rpx;font-size:54rpx;font-weight:800;letter-spacing:-.05em}.lead{display:block;margin-top:16rpx;color:var(--theme-muted);font:22rpx/1.6 sans-serif}.search-box{display:flex;align-items:center;margin-top:34rpx;padding:10rpx 14rpx 10rpx 24rpx;border:2rpx solid var(--theme-line);border-radius:22rpx;background:var(--theme-surface-strong)}.search-box input{flex:1;height:64rpx;color:var(--theme-text);font:22rpx sans-serif}.search-box button{margin:0;padding:10rpx 16rpx;color:var(--theme-accent);border:0;background:transparent;font-size:19rpx}.quick-scroll,.category-tabs,.article-index{margin-top:20rpx;white-space:nowrap}.quick-row,.category-row,.article-row{display:flex;gap:12rpx}.quick-row{align-items:center}.quick-row>text{padding:0 8rpx;color:var(--theme-muted);font:17rpx sans-serif}.quick-row button,.article-row button{flex:0 0 auto;margin:0;padding:13rpx 20rpx;color:var(--theme-text-soft);border:2rpx solid var(--theme-line);border-radius:15rpx;background:var(--theme-surface);font-size:19rpx}.category-row button{display:flex;width:260rpx;flex:0 0 auto;flex-direction:column;align-items:flex-start;margin:0;padding:18rpx;color:var(--theme-muted);border:2rpx solid var(--theme-line);border-radius:18rpx;background:var(--theme-surface);text-align:left}.category-row b{color:var(--theme-text);font-size:23rpx}.category-row text{margin-top:7rpx;font:16rpx/1.4 sans-serif;white-space:normal}.category-row button.active,.article-row button.active{border-color:var(--theme-accent);background:var(--theme-surface-soft)}.article{margin-top:24rpx;padding:30rpx 26rpx;border:2rpx solid var(--theme-line);border-radius:26rpx;background:var(--theme-surface);box-shadow:0 22rpx 58rpx var(--theme-shadow)}.article-kicker{color:var(--theme-accent);font:17rpx sans-serif;font-weight:800;letter-spacing:.12em}.article-title{margin-top:12rpx;font-size:42rpx;font-weight:800}.article-summary{display:block;margin-top:16rpx;color:var(--theme-muted);font:22rpx/1.7 sans-serif}.rule-block{margin-top:28rpx;padding-top:24rpx;border-top:2rpx solid var(--theme-line)}.block-title{font-size:27rpx;font-weight:800}.note-text{display:block;margin-top:15rpx;padding:18rpx;border-left:6rpx solid var(--theme-gold);color:var(--theme-text-soft);background:var(--theme-surface-strong);font:20rpx/1.7 sans-serif}.fact-list,.bullet-list{margin-top:14rpx}.fact-list>view,.bullet-list>view{display:grid;grid-template-columns:150rpx 1fr;gap:18rpx;padding:16rpx 4rpx;border-bottom:2rpx solid var(--theme-line);font:20rpx/1.55 sans-serif}.bullet-list>view{grid-template-columns:36rpx 1fr}.fact-list b,.bullet-list b{color:var(--theme-accent)}.rule-table-scroll{margin-top:16rpx}.rule-table{width:max-content;min-width:100%;border:2rpx solid var(--theme-line);border-radius:14rpx;overflow:hidden}.table-row{display:flex;border-bottom:2rpx solid var(--theme-line)}.table-row:last-child{border-bottom:0}.table-row text{box-sizing:border-box;width:220rpx;flex:1;padding:15rpx;border-right:2rpx solid var(--theme-line);font:18rpx/1.45 sans-serif;white-space:normal}.table-row text:last-child{border-right:0}.table-head{color:var(--theme-accent);background:var(--theme-surface-strong);font-weight:800}.rule-source{display:flex;flex-direction:column;gap:8rpx;margin-top:30rpx;padding-top:20rpx;color:var(--theme-muted);border-top:2rpx solid var(--theme-line);font:17rpx/1.5 sans-serif}.rule-source text:first-child{color:var(--theme-accent);font-weight:800}.search-results{margin-top:26rpx}.result-count{color:var(--theme-muted);font:19rpx sans-serif}.result-card{margin-top:14rpx;padding:22rpx;border:2rpx solid var(--theme-line);border-radius:18rpx;background:var(--theme-surface)}.result-card text{display:block}.result-card text:first-child{font-size:26rpx;font-weight:800}.result-card text:last-child{margin-top:8rpx;color:var(--theme-muted);font:19rpx/1.5 sans-serif}.empty-panel{margin-top:20rpx;padding:40rpx;color:var(--theme-muted);text-align:center}
