deploy-url.txt
deploy-token.txt
# 临时/构建缓存
__pycache__/
*.tmp.*
/analysis-output/
# 参考资料（规则手册与赛区通知，勿提交）
*.pdf
注意事项.txt
# 本地设计原图（正式资源请放入 internal/server/web/assets）
/local-assets/
# Local worktree for the macOS token branch.
/.tmp-macos-token-rebase/
# 微信开发者工具的个人设置
apps/miniprogram/project.private.config.json
# JetBrains IDE 个人配置
/.idea/
# 分析研究台的可再生产物（缓存、图表、模型）：由 builder + 脚本确定性重算，勿入库
/research/output/
# Claude Code 个人权限设置（本机累积的一次性授权，不共享）；.claude/settings.json 与 skills/ 入库
/.claude/settings.local.json
# 爬虫运行日志（本机排错用，可再生）
/.crawl-logs/
